# Environment Configuration
APP_ENV=development
DEBUG=true

# Mock Modes for Autonomous Local Development & Testing
MOCK_KUBERNETES=true
MOCK_LLM=true
MOCK_LOGS=true
MOCK_DATABASE=true

# Databases & Observability
MONGODB_URI=mongodb://localhost:27017/smartops
PROMETHEUS_URL=http://localhost:9090
ELASTICSEARCH_URL=http://localhost:9200

# Kubernetes
KUBERNETES_NAMESPACE=smartops

# MCP Server
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8005
SMARTOPS_BACKEND_URL=http://127.0.0.1:8000

# Microservices URLs
USER_SERVICE_URL=http://127.0.0.1:8001
ORDER_SERVICE_URL=http://127.0.0.1:8002
PAYMENT_SERVICE_URL=http://127.0.0.1:8003

# Security & JWT
JWT_SECRET=smartops-ai-super-secret-token-signing-key-for-local-dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider (Optional when MOCK_LLM=true)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
